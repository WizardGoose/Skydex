{
  "schemaVersion": 1,
  "id": "skydex",
  "version": "${version}",
  "name": "Skydex",
  "description": "Connects the Skydex website to the SkyBlock information and in-game Greenhouse tools that only the Minecraft client can provide.",
  "authors": [
    "WizardGoose"
  ],
  "contact": {
    "sources": "https://github.com/WizardGoose/Skydex/tree/master/mod"
  },
  "license": "MIT",
  "environment": "client",
  "entrypoints": {
    "client": [
      "com.skydex.SkydexMod"
    ]
  },
  "mixins": [
    "skydex.client.mixins.json"
  ],
  "depends": {
    "fabricloader": ">=0.19.3",
    "minecraft": "${minecraft_version}",
    "java": ">=25",
    "fabric-api": ">=${fabric_api_version}"
  }
}
