# Snapshots the networth parity gate downloads for itself. The SkyHelper
# prices file carries no licence, so no copy of it is ever committed.
tools/.cache

# Local working aids, kept off the released project. Layout.tsx discovers this
# folder with import.meta.glob rather than importing it, so the app builds and
# runs the same when it is not here, which is the case for every clone.
src/dev-local/

# Design scratch. Colour and frame studies that fed the visual work but are not
# part of the shipped app.
bench/

# Internal intel notes written while studying other projects. Working material,
# not documentation for this project.
docs/design-intel.md
docs/skycrypt-style-intel.md

# Local planning notes and draft cover artwork.
docs/superpowers/
docs/research/
docs/greenhouse-time-research.md
docs/hypixel-api-cheatsheet.md
docs/networth-research.md
docs/route-engine-design.md
docs/devpost-cover-concepts.html
docs/assets/devpost-export-fonts.js

# Editor and agent workspace configuration. The repository should read the same
# to every contributor and every tool, so no local session scaffolding ships.
.claude/
.codex/
CLAUDE.md
AGENTS.md
*.claude.md

# Local credentials and environment overrides.
.env
.env.*
!.env.example

# Dataset build scripts that carry a maintainer contact address in their
# User-Agent header. They are held back so no personal email is published; the
# datasets they produce are committed, so the app builds without them.
tools/build-item-icons.mjs
tools/build-planner-targets.mjs
tools/dump-datasets.mjs
tools/wiki-dump.mjs


# Fabric mod build output and local Minecraft development directories. The
# downloadable JAR belongs to the GitHub Release, never the repository.
mod/.gradle/
mod/build/
mod/run/
mod/runs/
mod/logs/
mod/*.log
